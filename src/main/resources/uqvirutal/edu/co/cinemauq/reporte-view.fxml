<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="620.0" prefWidth="940.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uqvirutal.edu.co.cinemauq.viewController.ReporteViewController">
    <children>
        <VBox prefHeight="620.0" prefWidth="940.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <!-- Barra Superior -->
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onVolver" text="&lt; Volver" />
                        <Label text="Módulo de Reportes Administrativos - CinemaUQ">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Contenido Principal en 2 Columnas -->
                <HBox prefHeight="520.0" spacing="25.0" VBox.vgrow="ALWAYS">
                    <children>

                        <!-- Columna Izquierda: Configuración del Reporte -->
                        <VBox prefWidth="330.0" spacing="12.0">
                            <children>
                                <Label text="Parámetros del Reporte">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>

                                <Label text="Tipo de Reporte (Factory Method):" />
                                <ComboBox fx:id="cmbTipoReporte" maxWidth="1.7976931348623157E308" promptText="Seleccione reporte" />

                                <Label text="Formato de Exportación (Bridge / Adapter):" />
                                <ComboBox fx:id="cmbFormato" maxWidth="1.7976931348623157E308" promptText="TXT / PDF" />

                                <Label text="Fecha de Inicio:" />
                                <DatePicker fx:id="dpFechaInicio" maxWidth="1.7976931348623157E308" />

                                <Label text="Fecha de Fin:" />
                                <DatePicker fx:id="dpFechaFin" maxWidth="1.7976931348623157E308" />

                                <Label text="Ruta / Nombre del Archivo:" />
                                <TextField fx:id="txtRutaArchivo" promptText="Ej. reportes/ventas_mes" />

                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onGenerarReporte" style="-fx-background-color: #1565C0; -fx-text-fill: white;" text="Generar y Exportar Reporte">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>

                        <!-- Columna Derecha: Vista Previa del Reporte -->
                        <VBox prefWidth="540.0" spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Vista Previa del Contenido Exportado">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>

                                <TextArea fx:id="txtAreaVistaPrevia" editable="false" prefHeight="470.0" style="-fx-font-family: 'Consolas', 'Monospaced'; -fx-font-size: 12;" wrapText="true" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>